{
  "name": "lazyforza-race-server-cloudflare",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-repository-assets.mjs",
    "check:generated": "node scripts/generate-repository-assets.mjs --check",
    "build": "npm run generate && tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
