    {
      "name": "PenaltyKind",
      "targets": { "server": "RacePenaltyKind", "client": "RacePenaltyKind", "typescript": "PenaltyKind" },
      "values": ["warning", "time", "driveThrough", "stopAndGo", "gridDrop", "disqualification"]
